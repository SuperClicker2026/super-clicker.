.admin-tabs{display:flex;gap:6px;overflow-x:auto;padding:5px 0 12px;scrollbar-width:none;touch-action:pan-x;overscroll-behavior-x:contain}
.admin-tabs button{flex:0 0 auto;margin:0;padding:10px 13px;font-size:12px;background:#ffffff14}
.admin-tabs button.selected{background:linear-gradient(135deg,#f59e0b,#d946ef);box-shadow:0 0 14px #f59e0b77}
.admin-section{display:none;overflow-anchor:none}
.admin-section.selected{display:block}
.admin-box{background:#ffffff0b;border:1px solid #ffffff25;border-radius:15px;padding:13px;margin:10px 0;overflow-anchor:none}
.admin-box h3{margin:3px 0 12px;color:#ffe78a}
.admin-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.admin-grid button{margin:0;font-size:12px;padding:12px 5px}
.admin-field{margin:10px 0}
.admin-field label{display:block;font-size:13px;color:#d8caff}
.admin-field input{background:#100b27;color:white;border:1px solid #a78bfa}
.admin-danger{background:linear-gradient(135deg,#991b1b,#dc2626)}
.admin-warning{color:#ffcf4a;font-size:12px;line-height:1.5}
#adminMessage{padding:10px;border-radius:12px;background:#ffffff0c;min-height:25px}
button:active,.nav button:active,.admin-tabs button:active{transform:none!important}
button,.nav button,.admin-tabs button{-webkit-tap-highlight-color:transparent;touch-action:manipulation}
