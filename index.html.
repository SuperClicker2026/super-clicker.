<script>
"use strict";
const SAVE_KEY="superClickerSaveV6",BACKUP_KEY="superClickerBackupV6",MAX_COINS=1e15,MAX_GEMS=1e12;
const initialData=()=>({coins:0,gems:0,power:1,multiplier:1,rebirths:0,totalEarned:0,totalClicks:0,auto:0,upgrades:{enhanced:0,super:0,income:0,mult:0},claimed:[],usedPromos:[],dailyDate:"",lastBonusTime:0,chestKeys:0,chestsOpened:0,bestCombo:0,combo:0,lastClickTime:0,activePlanet:"cosmic",bossLevel:1,bossHp:100,bossesDefeated:0,ultimateCharge:0,artifacts:[],portals:[],planetUnlocks:[],ultimateUntil:0});
let data=initialData(),lastAcceptedClick=0,ultimateActive=false,clickAudioContext=null;
const promos={START100:100,SUPER500:500,POWERUP:250,KARMA123:1000};
const shop=[{id:"enhanced",name:"Усиленный клик",desc:"+1 монета за клик",base:30,max:100},{id:"super",name:"Супер-клик",desc:"+5 монет за клик",base:150,max:100},{id:"auto",name:"Автокликер",desc:"+1 монета каждую секунду",base:250,max:50},{id:"income",name:"Улучшение дохода",desc:"+10% к доходу",base:300,max:50},{id:"mult",name:"Множитель монет",desc:"+0.25 к множителю",base:500,max:20}];
const planets=[{id:"cosmic",name:"Земля",icon:"🌍",clicks:0,desc:"Твоя стартовая планета"},{id:"mars",name:"Марс",icon:"🔴",clicks:100,desc:"Планета огня"},{id:"ice",name:"Ледяной мир",icon:"🧊",clicks:500,desc:"Мир вечного холода"},{id:"void",name:"Пустота",icon:"🌌",clicks:1500,desc:"Тайны далёкой галактики"}];
const bosses=[{name:"Страж галактики",icon:"👹",hp:100,reward:500,rewardGems:2},{name:"Пожиратель звёзд",icon:"🐉",hp:1000,reward:5000,rewardGems:5},{name:"Тёмный колосс",icon:"👾",hp:10000,reward:30000,rewardGems:12},{name:"Повелитель пустоты",icon:"☠️",hp:100000,reward:200000,rewardGems:30},{name:"Космический титан",icon:"🛸",hp:1000000,reward:1000000,rewardGems:100}];
const artifacts=[{id:"crystal",name:"🔮 Кристалл силы",desc:"+10% к силе клика за уровень",cost:10,max:10},{id:"star",name:"⭐ Звезда богатства",desc:"+15% ко всем монетам за уровень",cost:15,max:10},{id:"heart",name:"💜 Сердце космоса",desc:"+5% к силе клика за уровень",cost:20,max:10}];
const portals=[{id:"nebula",name:"🌫️ Туманность",clicks:2500,gems:10,desc:"Туманное измерение"},{id:"dimension",name:"🌀 Измерение X",clicks:5000,gems:25,desc:"Мир за пределами времени"},{id:"galaxy",name:"🌠 Галактика титанов",clicks:10000,gems:50,desc:"Обитель древних сил"},{id:"infinity",name:"♾️ Бесконечность",clicks:25000,gems:100,desc:"Последняя граница"}];
const ranks=[{name:"Новичок",icon:"🌱",clicks:0,desc:"Твой путь только начинается"},{name:"Кликер",icon:"⚡",clicks:100,desc:"Ты освоил силу ядра"},{name:"Исследователь",icon:"🚀",clicks:500,desc:"Ты покоряешь новые миры"},{name:"Космический воин",icon:"🛡️",clicks:1500,desc:"Тебя знают в галактике"},{name:"Звёздный магистр",icon:"✨",clicks:5000,desc:"Ты управляешь энергией звёзд"},{name:"Легенда галактики",icon:"👑",clicks:15000,desc:"Твоё имя известно повсюду"},{name:"Властелин космоса",icon:"🌌",clicks:50000,desc:"Ты достиг невероятной силы"}];
const achievements=[
{id:"first",name:"Первый клик",desc:"Сделай 1 клик",reward:50,check:()=>data.totalClicks>=1},
{id:"click100",name:"Кликер",desc:"Сделай 100 кликов",reward:250,check:()=>data.totalClicks>=100},
{id:"coins1000",name:"Богач",desc:"Заработай 1 000 монет",reward:300,check:()=>data.totalEarned>=1000},
{id:"coins10000",name:"Мастер монет",desc:"Заработай 10 000 монет",reward:1000,check:()=>data.totalEarned>=10000},
{id:"rebirth",name:"Новая жизнь",desc:"Сделай перерождение",reward:500,check:()=>data.rebirths>=1},
{id:"chest1",name:"Охотник за сокровищами",desc:"Открой первый сундук",reward:500,check:()=>data.chestsOpened>=1},
{id:"chest10",name:"Коллекционер",desc:"Открой 10 сундуков",reward:2500,check:()=>data.chestsOpened>=10},
{id:"combo10",name:"На скорости",desc:"Собери комбо 10",reward:500,check:()=>data.bestCombo>=10},
{id:"combo50",name:"Молниеносный",desc:"Собери комбо 50",reward:2500,check:()=>data.bestCombo>=50},
{id:"planet",name:"Покоритель Марса",desc:"Открой Марс",reward:1000,check:()=>data.totalClicks>=100||data.planetUnlocks.includes("mars")},
{id:"click1000",name:"Легенда кликов",desc:"Сделай 1 000 кликов",reward:5000,check:()=>data.totalClicks>=1000},
{id:"boss1",name:"Охотник на боссов",desc:"Победи первого босса",reward:1500,check:()=>data.bossesDefeated>=1},
{id:"boss5",name:"Убийца титанов",desc:"Победи 5 боссов",reward:10000,check:()=>data.bossesDefeated>=5},
{id:"artifact",name:"Коллекционер артефактов",desc:"Купи артефакт",reward:1000,check:()=>data.artifacts.length>0},
{id:"portal",name:"Путешественник",desc:"Открой портал",reward:2000,check:()=>data.portals.length>0}
];
function el(id){return document.getElementById(id)}
function notify(t){el("message").textContent=t}
function validNumber(v,min=0,max=MAX_COINS){return typeof v==="number"&&Number.isFinite(v)&&v>=min&&v<=max}
function bossMaxHp(level){return Math.floor(100*Math.pow(2.4,Math.max(0,level-1)))}
function cleanData(raw){
const d=initialData();if(!raw||typeof raw!=="object"||Array.isArray(raw))return d;
d.coins=validNumber(raw.coins)?raw.coins:0;d.gems=validNumber(raw.gems,0,MAX_GEMS)?raw.gems:0;
d.power=validNumber(raw.power,1,1000000)?Math.floor(raw.power):1;d.multiplier=validNumber(raw.multiplier,.01,1000000)?raw.multiplier:1;
d.rebirths=validNumber(raw.rebirths,0,100000)?Math.floor(raw.rebirths):0;d.totalEarned=validNumber(raw.totalEarned)?raw.totalEarned:0;
d.totalClicks=validNumber(raw.totalClicks,0,1e12)?Math.floor(raw.totalClicks):0;d.auto=validNumber(raw.auto,0,50)?Math.floor(raw.auto):0;
d.lastBonusTime=validNumber(raw.lastBonusTime,0,Number.MAX_SAFE_INTEGER)?raw.lastBonusTime:0;d.chestKeys=validNumber(raw.chestKeys,0,1e9)?Math.floor(raw.chestKeys):0;
d.chestsOpened=validNumber(raw.chestsOpened,0,1e12)?Math.floor(raw.chestsOpened):0;d.bestCombo=validNumber(raw.bestCombo,0,1e9)?Math.floor(raw.bestCombo):0;
d.combo=validNumber(raw.combo,0,1e9)?Math.floor(raw.combo):0;d.lastClickTime=validNumber(raw.lastClickTime,0,Number.MAX_SAFE_INTEGER)?raw.lastClickTime:0;
d.dailyDate=typeof raw.dailyDate==="string"?raw.dailyDate:"";d.activePlanet=planets.some(p=>p.id===raw.activePlanet)?raw.activePlanet:"cosmic";
d.bossLevel=validNumber(raw.bossLevel,1,100000)?Math.floor(raw.bossLevel):1;d.bossHp=validNumber(raw.bossHp,0,1e15)?raw.bossHp:bossMaxHp(d.bossLevel);
d.bossesDefeated=validNumber(raw.bossesDefeated,0,1e9)?Math.floor(raw.bossesDefeated):0;
d.ultimateCharge=validNumber(raw.ultimateCharge,0,100)?raw.ultimateCharge:0;d.ultimateUntil=validNumber(raw.ultimateUntil,0,Number.MAX_SAFE_INTEGER)?raw.ultimateUntil:0;
if(raw.upgrades&&typeof raw.upgrades==="object")for(const k of ["enhanced","super","income","mult"]){const v=raw.upgrades[k];d.upgrades[k]=validNumber(v,0,100)?Math.floor(v):0}
d.claimed=Array.isArray(raw.claimed)?raw.claimed.filter(x=>achievements.some(a=>a.id===x)):[];
d.usedPromos=Array.isArray(raw.usedPromos)?raw.usedPromos.filter(x=>Object.prototype.hasOwnProperty.call(promos,x)):[];
if(Array.isArray(raw.artifacts))for(const a of artifacts){const s=raw.artifacts.find(x=>x&&x.id===a.id),level=s&&Number.isFinite(Number(s.level))?Math.max(0,Math.min(a.max,Math.floor(Number(s.level)))):0;if(level)d.artifacts.push({id:a.id,level})}
d.portals=Array.isArray(raw.portals)?raw.portals.filter(x=>portals.some(p=>p.id===x)):[];
d.planetUnlocks=Array.isArray(raw.planetUnlocks)?raw.planetUnlocks.filter(x=>planets.some(p=>p.id===x)):[];
return d;
}
function saveGame(){
try{const old=localStorage.getItem(SAVE_KEY);if(old){try{JSON.parse(old);localStorage.setItem(BACKUP_KEY,old)}catch(e){}}localStorage.setItem(SAVE_KEY,JSON.stringify(data));return true}catch(e){console.warn("Ошибка сохранения",e);return false}
}
function loadGame(){try{const s=localStorage.getItem(SAVE_KEY);if(!s){alert("Сохранение не найдено.");return}data=cleanData(JSON.parse(s));document.body.dataset.planet=data.activePlanet;update();alert("Сохранение загружено!")}catch(e){restoreBackup()}}
function restoreBackup(){try{const s=localStorage.getItem(BACKUP_KEY);if(!s){alert("Резервная копия не найдена.");return}data=cleanData(JSON.parse(s));document.body.dataset.planet=data.activePlanet;update();alert("Резервная копия восстановлена.")}catch(e){alert("Не удалось восстановить копию.")}}
function artifactBonus(id){const a=data.artifacts.find(x=>x.id===id);return a?a.level:0}
function totalPower(){return Math.floor((data.power+data.upgrades.enhanced+data.upgrades.super*5)*data.multiplier*(1+data.upgrades.mult*.25)*(1+data.upgrades.income*.1)*(1+data.rebirths*.25)*(1+artifactBonus("crystal")*.1+artifactBonus("heart")*.05)*(1+artifactBonus("star")*.15))}
function addCoins(amount){if(!validNumber(amount)||data.coins+amount>MAX_COINS||data.totalEarned+amount>MAX_COINS)return false;data.coins+=amount;data.totalEarned+=amount;return true}
function playClickSound(){
try{
const AudioCtx=window.AudioContext||window.webkitAudioContext;if(!AudioCtx)return;
if(!clickAudioContext)clickAudioContext=new AudioCtx();
if(clickAudioContext.state==="suspended")clickAudioContext.resume();
const ctx=clickAudioContext,osc=ctx.createOscillator(),gain=ctx.createGain(),now=ctx.currentTime;
osc.type="sine";osc.frequency.setValueAtTime(650,now);osc.frequency.exponentialRampToValueAtTime(1100,now+.07);
gain.gain.setValueAtTime(.0001,now);gain.gain.exponentialRampToValueAtTime(.14,now+.01);gain.gain.exponentialRampToValueAtTime(.0001,now+.12);
osc.connect(gain);gain.connect(ctx.destination);osc.start(now);osc.stop(now+.13);
}catch(e){console.log("Звук недоступен")}
}
function update(){
el("balance").textContent="🪙 "+Math.floor(data.coins).toLocaleString("ru-RU");
el("statsline").textContent="💎 "+data.gems+" кристаллов · Уровень "+(1+data.rebirths);
el("clickInfo").textContent="За клик: "+totalPower()+" монет";
el("statistics").innerHTML="Всего заработано: "+Math.floor(data.totalEarned).toLocaleString("ru-RU")+"<br>Кликов: "+data.totalClicks+"<br>Сила клика: "+totalPower()+"<br>Автокликеров: "+data.auto+"<br>Перерождений: "+data.rebirths+"<br>Открыто сундуков: "+data.chestsOpened+"<br>Лучшее комбо: "+data.bestCombo+"<br>Побеждено боссов: "+data.bossesDefeated;
el("chestInfo").textContent="🔑 Ключей: "+data.chestKeys;el("chestButton").disabled=data.chestKeys<=0;
renderShop();renderAchievements();renderRebirth();renderLeaderboard();renderPlanets();renderBoss();renderUltimate();renderPortals();renderArtifacts();renderRanks();updateBonusTimer();adminRefresh();saveGame();
}
function showFloat(x,y,text){const n=document.createElement("div");n.className="float";n.textContent=text;n.style.left=x+"px";n.style.top=y+"px";document.body.appendChild(n);setTimeout(()=>n.remove(),850)}
function createParticles(x,y){for(let i=0;i<12;i++){const p=document.createElement("div");p.className="particle";p.style.left=x+"px";p.style.top=y+"px";const a=Math.PI*2*i/12,d=35+Math.random()*55;p.style.setProperty("--dx",Math.cos(a)*d+"px");p.style.setProperty("--dy",Math.sin(a)*d+"px");document.body.appendChild(p);setTimeout(()=>p.remove(),750)}}
function clickCoin(e){
e.preventDefault();const now=Date.now();if(now-lastAcceptedClick<45)return;if(data.totalClicks>=1e12)return;lastAcceptedClick=now;playClickSound();
data.combo=now-data.lastClickTime<1500?data.combo+1:1;data.lastClickTime=now;data.bestCombo=Math.max(data.bestCombo,data.combo);data.totalClicks++;
let reward=totalPower(),r=Math.random();if(r<.03)reward*=5;else if(r<.15)reward*=2;
const comboBonus=data.combo>=50?5:data.combo>=25?3:data.combo>=10?2:1;
reward=Math.floor(reward*comboBonus);if(Date.now()<data.ultimateUntil)reward*=10;
if(!addCoins(reward))return;
damageBoss(reward);data.ultimateCharge=Math.min(100,data.ultimateCharge+1.5);
if(data.totalClicks%50===0){data.chestKeys++;el("chestMessage").textContent="🔑 Новый ключ за 50 кликов!"}
el("comboDisplay").textContent=data.combo>1?"⚡ Комбо: "+data.combo+(data.combo>=10?" 🔥 x"+comboBonus+" КОМБО!":""):"";
showFloat(e.clientX,e.clientY,"+"+reward);createParticles(e.clientX,e.clientY);
el("message").textContent=r<.03?"🌟 ЛЕГЕНДАРНЫЙ КРИТИЧЕСКИЙ КЛИК!":r<.15?"✨ ДВОЙНАЯ ЭНЕРГИЯ!":"";
checkAchievements();update();
}
el("coin").addEventListener("pointerdown",clickCoin);
function renderBoss(){
const b=bosses[(data.bossLevel-1)%bosses.length],max=bossMaxHp(data.bossLevel);data.bossHp=Math.min(data.bossHp,max);
const pct=Math.max(0,Math.min(100,data.bossHp/max*100));
["bossIcon","bossIcon2"].forEach(id=>el(id).textContent=b.icon);
["bossName","bossName2"].forEach(id=>el(id).textContent=b.name+" · Уровень "+data.bossLevel);
["bossHealthBar","bossHealthBar2"].forEach(id=>el(id).style.width=pct+"%");
const info="❤️ "+Math.ceil(data.bossHp).toLocaleString("ru-RU")+" / "+max.toLocaleString("ru-RU")+" HP";
["bossInfo","bossInfo2"].forEach(id=>el(id).textContent=info);
}
function damageBoss(amount){
if(data.bossHp<=0)return;data.bossHp=Math.max(0,data.bossHp-amount);
if(data.bossHp===0){const b=bosses[(data.bossLevel-1)%bosses.length],reward=b.reward*data.bossLevel;addCoins(reward);data.gems=Math.min(MAX_GEMS,data.gems+b.rewardGems);data.bossesDefeated++;data.bossLevel++;data.bossHp=bossMaxHp(data.bossLevel);const msg="🏆 БОСС ПОБЕЖДЁН! +"+reward.toLocaleString("ru-RU")+" монет и +"+b.rewardGems+" 💎";el("bossMessage").textContent=msg;el("bossMessage2").textContent=msg}
else el("bossMessage").textContent="⚔️ Босс получил "+Math.floor(amount)+" урона!";
}
function renderUltimate(){
const active=Date.now()<data.ultimateUntil;ultimateActive=active;
el("ultimateInfo").textContent=active?"🔥 УЛЬТА АКТИВНА! Осталось "+Math.ceil((data.ultimateUntil-Date.now())/1000)+" сек.":"Заряд: "+Math.floor(data.ultimateCharge)+"%";
el("ultimateBar").style.width=data.ultimateCharge+"%";
const b=el("ultimateButton");b.disabled=active||data.ultimateCharge<100;b.textContent=active?"🔥 АКТИВНА":data.ultimateCharge>=100?"⚡ АКТИВИРОВАТЬ УЛЬТУ":"⚡ УЛЬТА x10";
}
function activateUltimate(){if(data.ultimateCharge<100||Date.now()<data.ultimateUntil)return;data.ultimateCharge=0;data.ultimateUntil=Date.now()+15000;ultimateActive=true;notify("⚡ КОСМИЧЕСКАЯ УЛЬТА АКТИВИРОВАНА! x10");update()}
function renderPortals(){el("portalList").innerHTML=portals.map(p=>{const opened=data.portals.includes(p.id),ready=data.totalClicks>=p.clicks&&data.gems>=p.gems;return `<div class="portal"><b>${p.name}</b><p class="small">${p.desc}</p><div class="small">Нужно: ${p.clicks.toLocaleString("ru-RU")} кликов и ${p.gems} 💎</div><button ${opened||!ready?"disabled":""} onclick="openPortal('${p.id}')">${opened?"Открыт ✓":ready?"Открыть портал":"Закрыт 🔒"}</button></div>`}).join("")}
function openPortal(id){const p=portals.find(x=>x.id===id);if(!p||data.portals.includes(id)||data.totalClicks<p.clicks||data.gems<p.gems)return;data.gems-=p.gems;data.portals.push(id);notify("🌀 ПОРТАЛ ОТКРЫТ: "+p.name);checkAchievements();update()}
function renderArtifacts(){el("artifactList").innerHTML=artifacts.map(a=>{const level=artifactBonus(a.id),cost=a.cost*(level+1);return `<div class="artifact"><b>${a.name}</b><p class="small">${a.desc}</p><div>Уровень: ${level}/${a.max}</div><button ${level>=a.max||data.gems<cost?"disabled":""} onclick="buyArtifact('${a.id}')">${level>=a.max?"МАКСИМУМ":"Купить за "+cost+" 💎"}</button></div>`}).join("")}
function buyArtifact(id){const a=artifacts.find(x=>x.id===id);if(!a)return;const level=artifactBonus(id),cost=a.cost*(level+1);if(level>=a.max||data.gems<cost)return;data.gems-=cost;const found=data.artifacts.find(x=>x.id===id);if(found)found.level++;else data.artifacts.push({id,level:1});checkAchievements();update()}
function renderRanks(){let current=ranks[0],next=null;for(const r of ranks){if(data.totalClicks>=r.clicks)current=r;else{next=r;break}}el("rankHeader").textContent=current.icon+" "+current.name;el("rankName").textContent=current.icon+" "+current.name;el("rankDescription").textContent=current.desc;el("rankBar").style.width=(next?Math.min(100,(data.totalClicks-current.clicks)/(next.clicks-current.clicks)*100):100)+"%";el("rankProgress").textContent=next?"Кликов: "+data.totalClicks.toLocaleString("ru-RU")+" · До ранга "+next.name+": "+(next.clicks-data.totalClicks).toLocaleString("ru-RU"):"Максимальный ранг достигнут!"}
function openChest(){if(data.chestKeys<=0)return;data.chestKeys--;data.chestsOpened++;const r=Math.random();let msg;if(r<.08){const n=10+Math.floor(Math.random()*16);data.gems=Math.min(MAX_GEMS,data.gems+n);msg="💎 ЛЕГЕНДАРНО! Ты получил "+n+" кристаллов!"}else if(r<.30){const n=5000+Math.floor(Math.random()*5001);addCoins(n);msg="🌟 РЕДКАЯ НАГРАДА! +"+n+" монет!"}else{const n=500+Math.floor(Math.random()*2501);addCoins(n);msg="🎁 Ты получил "+n+" монет!"}el("chestMessage").textContent=msg;checkAchievements();update()}
function price(item){const level=item.id==="auto"?data.auto:data.upgrades[item.id];return Math.floor(item.base*Math.pow(1.65,level))}
function renderShop(){el("shopItems").innerHTML=shop.map(i=>{const level=i.id==="auto"?data.auto:data.upgrades[i.id],cost=price(i),max=level>=i.max;return `<div class="item"><div><b>${i.name}</b><br><span class="small">${i.desc} · Уровень ${level}/${i.max}</span></div><button ${max||data.coins<cost?"disabled":""} onclick="buy('${i.id}')">${max?"МАКС":"🪙 "+cost.toLocaleString("ru-RU")}</button></div>`}).join("")}
function buy(id){const item=shop.find(x=>x.id===id);if(!item)return;const level=id==="auto"?data.auto:data.upgrades[id],cost=price(item);if(level>=item.max||data.coins<cost||!validNumber(cost))return;data.coins-=cost;if(id==="auto")data.auto++;else data.upgrades[id]++;update()}
setInterval(()=>{if(data.auto>0){const earned=data.auto;if(addCoins(earned))update()}},1000);
function dailyReward(){const today=new Date().toLocaleDateString();if(data.dailyDate===today){notify("Награда уже получена сегодня!");return}data.dailyDate=today;data.gems=Math.min(MAX_GEMS,data.gems+2);addCoins(250*(data.rebirths+1));notify("🎁 Ежедневная награда получена!");update()}
function timedBonus(){const now=Date.now();if(now-data.lastBonusTime<600000)return;data.lastBonusTime=now;const reward=Math.floor(100+Math.random()*901);addCoins(reward);notify("🎉 Бонус: +"+reward+" монет!");update()}
function updateBonusTimer(){const remaining=600000-(Date.now()-data.lastBonusTime),b=el("bonusButton");if(!b)return;if(remaining<=0){b.disabled=false;el("bonusTimer").textContent="Бонус доступен!"}else{b.disabled=true;el("bonusTimer").textContent="Следующий бонус через "+Math.floor(remaining/60000)+":"+String(Math.floor(remaining%60000/1000)).padStart(2,"0")}}
setInterval(updateBonusTimer,1000);
function renderAchievements(){el("achievementList").innerHTML=achievements.map(a=>{const done=a.check(),claimed=data.claimed.includes(a.id);return `<div class="item"><div><b>${a.name}</b><br><span class="small">${a.desc} · Награда: ${a.reward}</span></div><button ${!done||claimed?"disabled":""} onclick="claimAchievement('${a.id}')">${claimed?"Получено":done?"Забрать":"Не выполнено"}</button></div>`}).join("")}
function claimAchievement(id){const a=achievements.find(x=>x.id===id);if(!a||!a.check()||data.claimed.includes(id))return;data.claimed.push(id);addCoins(a.reward);update()}
function checkAchievements(){renderAchievements();saveGame()}
function renderPlanets(){
const current=planets.find(p=>p.id===data.activePlanet)||planets[0],next=planets.find(p=>data.totalClicks<p.clicks&&p.clicks>0&&!data.planetUnlocks.includes(p.id)),progress=next?Math.min(100,data.totalClicks/next.clicks*100):100;
el("planetProgress").innerHTML="<b>Текущий мир: "+current.icon+" "+current.name+"</b><div class='progress'><div style='width:"+progress+"%'></div></div><div class='small'>Кликов всего: "+data.totalClicks+(next?" · До следующей планеты: "+next.clicks:" · Все планеты открыты!")+"</div>";
el("planetList").innerHTML=planets.map(p=>{const unlocked=data.totalClicks>=p.clicks||data.planetUnlocks.includes(p.id),selected=data.activePlanet===p.id;return `<div class="planet-card ${selected?"selected":""}"><div class="planet-icon">${p.icon}</div><b>${p.name}</b><div class="small">${p.desc}</div><div class="small">${p.clicks===0?"Стартовый мир":"Нужно кликов: "+p.clicks}</div><button ${!unlocked||selected?"disabled":""} onclick="selectPlanet('${p.id}')">${selected?"Выбрана":unlocked?"Посетить":"Закрыта 🔒"}</button></div>`}).join("")}
function selectPlanet(id){const p=planets.find(x=>x.id===id);if(!p||(data.totalClicks<p.clicks&&!data.planetUnlocks.includes(id)))return;data.activePlanet=id;document.body.dataset.planet=id;update()}
function renderRebirth(){const cost=10000*Math.pow(5,data.rebirths);el("rebirthInfo").innerHTML="Стоимость: "+cost.toLocaleString("ru-RU")+" монет<br>Кристаллы за перерождение: "+(data.rebirths+1)+"<br>Текущих перерождений: "+data.rebirths}
function doRebirth(){const cost=10000*Math.pow(5,data.rebirths);if(!Number.isFinite(cost)||data.coins<cost){alert("Недостаточно монет!");return}if(!confirm("Переродиться? Монеты и улучшения сбросятся."))return;data.coins=0;data.power=1;data.auto=0;data.upgrades={enhanced:0,super:0,income:0,mult:0};data.rebirths++;data.gems=Math.min(MAX_GEMS,data.gems+data.rebirths);checkAchievements();update()}
function usePromo(){const code=el("promoInput").value.trim().toUpperCase();if(!Object.prototype.hasOwnProperty.call(promos,code)){el("promoMessage").textContent="Неверный промокод.";return}if(data.usedPromos.includes(code)){el("promoMessage").textContent="Этот код уже использован.";return}if(data.coins+promos[code]>MAX_COINS){el("promoMessage").textContent="Слишком много монет.";return}data.usedPromos.push(code);addCoins(promos[code]);el("promoMessage").textContent="Промокод активирован! +"+promos[code]+" монет";el("promoInput").value="";update()}
function setTheme(theme){if(!["cosmic","dark","pink","neon","light"].includes(theme))return;document.body.dataset.theme=theme;try{localStorage.setItem("superClickerTheme",theme)}catch(e){}}
function updateNavHint(){const n=el("mainNav"),left=n.scrollLeft>3,right=n.scrollLeft+n.clientWidth<n.scrollWidth-3;el("navLeft").style.opacity=left?"1":".15";el("navRight").style.opacity=right?"1":".15";el("navHintText").textContent=left&&right?"Листай влево или вправо":right?"Листай вправо, чтобы увидеть ещё →":left?"← Листай влево, чтобы вернуться":"Выбери раздел игры"}
function showPage(id){const p=el(id);if(!p)return;document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));p.classList.add("active");document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===id));if(id==="admin")adminRefresh();updateNavHint()}
el("mainNav").addEventListener("scroll",updateNavHint,{passive:true});window.addEventListener("resize",updateNavHint);
function resetGame(){
if(!confirm("ВНИМАНИЕ! Весь прогресс будет удалён. Продолжить?"))return;
try{localStorage.removeItem(SAVE_KEY);localStorage.removeItem(BACKUP_KEY)}catch(e){}
data=initialData();ultimateActive=false;lastAcceptedClick=0;
["promoInput","adminCoins","adminGems","adminPower","adminBossLevel"].forEach(id=>{if(el(id))el(id).value=""});
["promoMessage","message","chestMessage","comboDisplay","adminMessage","bossMessage","bossMessage2"].forEach(id=>el(id).textContent="");
el("adminPanel").style.display="none";document.body.dataset.planet="cosmic";saveGame();update();showPage("game");alert("Готово! Прогресс полностью сброшен.")
}
function renderLeaderboard(){const entries=[{name:"КосмоКликер",score:250000},{name:"MegaPlayer",score:125000},{name:"StarCoin",score:80000},{name:"ClickMaster",score:45000},{name:"Ты",score:Math.floor(data.totalEarned)}];entries.sort((a,b)=>b.score-a.score);el("leaderList").innerHTML=entries.map((x,i)=>`<div class="item"><b>${i+1}. ${x.name}</b><span>${x.score.toLocaleString("ru-RU")} 🪙</span></div>`).join("")}
function adminTab(name,button){document.querySelectorAll(".admin-section").forEach(x=>x.classList.remove("selected"));document.querySelectorAll(".admin-tabs button").forEach(x=>x.classList.remove("selected"));const s=el("adm-"+name);if(s)s.classList.add("selected");if(button)button.classList.add("selected")}
function adminMessage(t){el("adminMessage").textContent=t}
function adminRefresh(){const v={admCoinsView:Math.floor(data.coins).toLocaleString("ru-RU"),admGemsView:data.gems.toLocaleString("ru-RU"),admPowerView:totalPower().toLocaleString("ru-RU"),admBossView:data.bossLevel.toLocaleString("ru-RU"),admClicksView:data.totalClicks.toLocaleString("ru-RU"),admRebirthView:data.rebirths.toLocaleString("ru-RU")};for(const id in v)if(el(id))el(id).textContent=v[id]}
function adminAddCoins(amount){const n=amount===undefined?Number(el("adminCoins").value):amount;if(!validNumber(n,1)||data.coins+n>MAX_COINS||data.totalEarned+n>MAX_COINS){adminMessage("❌ Некорректное количество монет.");return}addCoins(n);el("adminCoins").value="";adminMessage("✅ Добавлено "+n.toLocaleString("ru-RU")+" монет!");update()}
function adminSetCoins(){const n=Number(el("adminCoins").value);if(!validNumber(n)){adminMessage("❌ Введи корректное количество монет.");return}data.coins=n;el("adminCoins").value="";adminMessage("✅ Баланс монет установлен!");update()}
function adminAddGems(amount){const n=amount===undefined?Number(el("adminGems").value):amount;if(!validNumber(n,1,MAX_GEMS)){adminMessage("❌ Некорректное количество кристаллов.");return}data.gems=Math.min(MAX_GEMS,data.gems+n);el("adminGems").value="";adminMessage("💎 Кристаллы добавлены!");update()}
function adminSetGems(){const n=Number(el("adminGems").value);if(!validNumber(n,0,MAX_GEMS)){adminMessage("❌ Введи корректное количество кристаллов.");return}data.gems=n;el("adminGems").value="";adminMessage("💎 Баланс кристаллов установлен!");update()}
function adminSetPower(){const n=Number(el("adminPower").value);if(!validNumber(n,1,1000000)){adminMessage("❌ Сила должна быть от 1 до 1 000 000.");return}data.power=Math.floor(n);el("adminPower").value="";adminMessage("⚡ Сила ядра изменена!");update()}
function adminPowerPreset(n){data.power=n;adminMessage("⚡ Сила клика установлена: "+n.toLocaleString("ru-RU"));update()}
function adminSetMultiplier(n){if(!validNumber(n,.01,1000000))return;data.multiplier=n;adminMessage("🚀 Множитель установлен: x"+n);update()}
function adminUnlockPlanets(){data.planetUnlocks=planets.map(p=>p.id);adminMessage("🪐 Все планеты открыты! Счётчик кликов не изменён.");update()}
function adminUnlockPortals(){data.portals=portals.map(p=>p.id);adminMessage("🌀 Все порталы открыты!");update()}
function adminSetPlanet(id){if(!planets.some(p=>p.id===id))return;data.activePlanet=id;document.body.dataset.planet=id;adminMessage("🪐 Мир изменён!");update()}
function adminMaxArtifacts(){data.artifacts=artifacts.map(a=>({id:a.id,level:a.max}));adminMessage("💎 Все артефакты улучшены до максимума!");update()}
function adminSetBoss(){const n=Number(el("adminBossLevel").value);if(!validNumber(n,1,100000)){adminMessage("❌ Уровень босса должен быть от 1 до 100 000.");return}data.bossLevel=Math.floor(n);data.bossHp=bossMaxHp(data.bossLevel);el("adminBossLevel").value="";adminMessage("👾 Уровень босса изменён!");update()}
function adminHealBoss(){data.bossHp=bossMaxHp(data.bossLevel);adminMessage("❤️ Здоровье босса восстановлено!");update()}
function adminDefeatBoss(){if(!confirm("Завершить бой и выдать награду за босса?"))return;const b=bosses[(data.bossLevel-1)%bosses.length],reward=b.reward*data.bossLevel;addCoins(reward);data.gems=Math.min(MAX_GEMS,data.gems+b.rewardGems);data.bossesDefeated++;data.bossLevel++;data.bossHp=bossMaxHp(data.bossLevel);adminMessage("🏆 Босс побеждён! Награда выдана.");checkAchievements();update()}
function adminUnlockAchievements(){achievements.forEach(a=>{if(!data.claimed.includes(a.id)){data.claimed.push(a.id);addCoins(a.reward)}});adminMessage("🏆 Все достижения отмечены полученными!");update()}
function adminGiveKeys(){data.chestKeys=Math.min(1e9,data.chestKeys+100);adminMessage("🎁 Выдано 100 ключей!");update()}
function adminGiveRebirth(){data.rebirths=Math.min(100000,data.rebirths+1);data.gems=Math.min(MAX_GEMS,data.gems+data.rebirths);adminMessage("🌌 Перерождение добавлено!");checkAchievements();update()}
function adminResetUpgrades(){if(!confirm("Сбросить все улучшения магазина и силу клика?"))return;data.power=1;data.multiplier=1;data.auto=0;data.upgrades={enhanced:0,super:0,income:0,mult:0};data.artifacts=[];adminMessage("Улучшения сброшены.");update()}
function adminClaimBonus(){addCoins(5000);data.gems=Math.min(MAX_GEMS,data.gems+10);adminMessage("🎁 Выдано 5 000 монет и 10 кристаллов!");update()}
let titleClicks=[];
el("gameTitle").addEventListener("click",()=>{const now=Date.now();titleClicks=titleClicks.filter(t=>now-t<2000);titleClicks.push(now);if(titleClicks.length>=5){el("adminPanel").style.display="block";showPage("admin");titleClicks=[]}});
document.addEventListener("contextmenu",e=>e.preventDefault());
document.addEventListener("copy",e=>e.preventDefault());document.addEventListener("cut",e=>e.preventDefault());
document.addEventListener("keydown",e=>{if((e.ctrlKey||e.metaKey)&&["c","x","u","s","a"].includes(e.key.toLowerCase()))e.preventDefault()});
setInterval(()=>{if(Date.now()>=data.ultimateUntil&&ultimateActive){ultimateActive=false;notify("⚡ Эффект ульты закончился!")}renderUltimate()},500);
try{const t=localStorage.getItem("superClickerTheme");if(["cosmic","dark","pink","neon","light"].includes(t))setTheme(t)}catch(e){}
try{const s=localStorage.getItem(SAVE_KEY);if(s)data=cleanData(JSON.parse(s))}catch(e){data=initialData()}
document.body.dataset.planet=data.activePlanet||"cosmic";
update();updateBonusTimer();saveGame();updateNavHint();
</script>
</body>
</html>
