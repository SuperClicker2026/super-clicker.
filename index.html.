.social-link{display:flex;align-items:center;gap:12px;text-decoration:none;color:white;background:#168bd0;padding:15px;border-radius:14px;margin:10px 0;font-weight:bold}
.security-note{font-size:12px;opacity:.75;line-height:1.5}
.boss-card{border:1px solid #ff6b9d;background:linear-gradient(145deg,#6b174544,#250e2e99)}
.boss-icon{text-align:center;font-size:65px;filter:drop-shadow(0 0 15px #ff386f)}
.boss-health{height:18px;background:#351020;border-radius:20px;overflow:hidden;margin:10px 0;border:1px solid #ff6b9d55}
.boss-health div{height:100%;background:linear-gradient(90deg,#ff315b,#ff9c45);transition:width .2s}
.ultimate{background:linear-gradient(135deg,#ff8c00,#ff315b)}
.artifact{background:#ffffff12;border:1px solid #f6d36555;border-radius:14px;padding:12px;margin:8px 0}
.rank{font-size:25px;font-weight:bold;color:#ffe78a;text-shadow:0 0 12px #ffb700}
.portal{background:#160e3caa;border:1px solid #9b72ff;border-radius:14px;padding:13px;margin:9px 0}
.nav-shell{position:fixed;bottom:0;left:0;right:0;z-index:20;padding:7px 0 calc(7px + env(safe-area-inset-bottom));background:linear-gradient(180deg,#17102bef,#090719f5);border-top:1px solid #a78bfa55;backdrop-filter:blur(18px);box-shadow:0 -8px 30px #0006}
.nav-hint{height:22px;display:flex;align-items:center;justify-content:center;gap:14px;font-size:11px;color:#cbbaff;letter-spacing:.5px}
.nav-hint .arrow{font-size:17px;color:#54eaff;text-shadow:0 0 10px #54eaff}
.nav{display:flex;flex-wrap:nowrap;justify-content:flex-start;align-items:center;gap:7px;padding:3px 12px 5px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-behavior:smooth;touch-action:pan-x;overscroll-behavior-x:contain}
.nav::-webkit-scrollbar,.admin-tabs::-webkit-scrollbar{display:none}
.nav button{flex:0 0 82px;width:82px;min-width:82px;height:57px;margin:0;padding:6px 3px;font-size:11px;line-height:1.35;border-radius:13px;background:#ffffff12;border:1px solid #ffffff25;box-shadow:none;color:#dcd4ff;scroll-snap-align:center}
.nav button.active{background:linear-gradient(135deg,#7956ff,#b04dff);border:1px solid #e3d4ff;box-shadow:0 0 15px #9b72ff99;color:white}
#adminPanel{display:none;border:2px solid #ffcf4a;background:radial-gradient(ellipse at 50% 0%,#8b5cf644,transparent 65%),linear-gradient(145deg,#160c35f5,#09091cf5);box-shadow:0 0 25px #a855f766,inset 0 0 30px #ffcf4a12;overflow-anchor:none}
