body[data-theme="light"]{background:linear-gradient(135deg,#dceaff,#a8c8ff);color:#17213a}
body[data-planet="mars"]{background:linear-gradient(135deg,#35101b,#8b302e,#25102b)}
body[data-planet="ice"]{background:linear-gradient(135deg,#062d50,#167ba0,#101c4c)}
body[data-planet="void"]{background:linear-gradient(135deg,#080018,#39005c,#090020)}
header{text-align:center;padding:18px 10px 8px}
h1{margin:5px;font-size:clamp(23px,6vw,34px);letter-spacing:3px;text-shadow:0 0 10px #a68aff,0 0 28px #8b5cf6}
#balance{font-size:clamp(27px,7vw,39px);font-weight:900;margin:12px;text-shadow:0 0 18px #ffe78a}
#statsline{opacity:.85;font-size:13px}
main{width:100%;max-width:760px;margin:auto;padding:10px 12px 160px}
.panel{width:100%;min-width:0;background:linear-gradient(145deg,#ffffff1c,#ffffff08);border:1px solid #ffffff35;border-radius:22px;padding:17px;margin:13px 0;backdrop-filter:blur(14px);box-shadow:0 8px 30px #0003,inset 0 1px #ffffff18}
button{border:1px solid #ffffff30;border-radius:14px;padding:13px 15px;font-size:15px;font-weight:bold;color:white;background:linear-gradient(135deg,#7956ff,#a044ee);cursor:pointer;margin:4px;max-width:100%;white-space:normal;overflow-wrap:anywhere;box-shadow:0 5px 15px #5424a955;transition:filter .18s;touch-action:manipulation}
button:active{filter:brightness(1.2)}
button:disabled{opacity:.4;filter:grayscale(.5);box-shadow:none;cursor:not-allowed}
input{width:100%;max-width:100%;min-width:0;padding:13px;border-radius:12px;border:1px solid #aaa;margin:7px 0;font-size:16px;user-select:text;-webkit-user-select:text;touch-action:manipulation}
h2{margin-top:4px;font-size:21px}
.small{font-size:12px;opacity:.75;overflow-wrap:anywhere;line-height:1.5}
.notice{text-align:center;min-height:22px;color:#ffe78a;overflow-wrap:anywhere}
.action-buttons{display:flex;flex-wrap:wrap;gap:5px}
.action-buttons button{flex:1 1 130px}
.page{display:none;min-width:0;animation:none!important;overflow-anchor:none}
.page.active{display:block}
.item{display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:1px solid #ffffff25;padding:13px 0;min-width:0;flex-wrap:wrap}
.item:last-child{border:0}
.item>div{flex:1 1 140px;min-width:0;overflow-wrap:anywhere}
.item button{flex:0 1 auto;min-width:100px}
.core-wrap{width:min(240px,68vw);height:min(240px,68vw);margin:22px auto;display:grid;place-items:center;position:relative}
.core-ring{position:absolute;width:100%;height:100%;border:3px solid #a78bfa;border-left-color:transparent;border-right-color:#54eaff;border-radius:50%;box-shadow:0 0 18px #8b5cf6,inset 0 0 18px #54eaff55;animation:orbit 7s linear infinite}
.core-ring.two{width:82%;height:82%;border:2px dashed #f0abfc;animation:orbitBack 5s linear infinite}
.core-ring.three{width:110%;height:110%;border:1px solid #54eaff66;animation:orbit 12s linear infinite}
#coin{position:relative;z-index:2;width:68%;height:68%;border-radius:50%;font-size:clamp(65px,19vw,95px);padding:0;margin:0;display:grid;place-items:center;background:radial-gradient(circle at 35% 25%,#fff,#a5f3fc 15%,#8b5cf6 48%,#3b0764 85%);box-shadow:0 0 25px #a78bfa,0 0 65px #7c3aed,inset 0 0 20px #fff9;animation:pulse 2.3s ease-in-out infinite;border:3px solid #ffffff80;touch-action:none}
#coin:active{animation:coreHit .25s ease}
@keyframes orbit{to{transform:rotate(360deg)}}
@keyframes orbitBack{to{transform:rotate(-360deg)}}
@keyframes pulse{0%,100%{transform:scale(1);filter:brightness(1)}50%{transform:scale(1.07);filter:brightness(1.3)}}
@keyframes coreHit{0%{transform:scale(1)}50%{transform:scale(.86)}100%{transform:scale(1.05)}}
.float{position:fixed;pointer-events:none;font-weight:bold;color:#fff28a;font-size:24px;animation:up .8s forwards;z-index:10;text-shadow:0 0 10px #ffdb55}
.particle{position:fixed;width:8px;height:8px;border-radius:50%;background:#a5f3fc;pointer-events:none;z-index:9;box-shadow:0 0 12px #a5f3fc;animation:particleFly .7s ease-out forwards}
@keyframes up{to{transform:translateY(-90px) scale(1.2);opacity:0}}
@keyframes particleFly{to{transform:translate(var(--dx),var(--dy)) scale(0);opacity:0}}
#comboDisplay{font-size:23px;font-weight:bold;color:#ffe78a;text-shadow:0 0 15px #ff9d00;min-height:30px;text-align:center}
.chest{font-size:65px;text-align:center;filter:drop-shadow(0 0 15px #ffc857);animation:chestGlow 2s infinite alternate}
@keyframes chestGlow{from{filter:drop-shadow(0 0 5px #ffc857)}to{filter:drop-shadow(0 0 25px #ffdf72)}}
.planet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.planet-card{background:#ffffff12;border:1px solid #ffffff30;border-radius:15px;padding:12px;text-align:center;min-width:0}
.planet-icon{font-size:42px}
.planet-card button{width:100%;margin:7px 0 0}
